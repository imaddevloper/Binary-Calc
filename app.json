{
  "expo": {
    "name": "Binary Calculator",
    "slug": "binary-calculator",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "binarycalculator",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "android": {
      "package": "com.binarycalculator.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Binary Calculator uses the camera only when you scan an IPv4 address. When online OCR is used, the image is sent to our OCR service and OpenAI for recognition; otherwise, recognition runs on your device. Images are not saved by the app.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Binary Calculator reads an image only when you choose one to scan for an IPv4 address."
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-file-system",
      "expo-notifications",
      "./plugins/withEmbeddedTermux"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
